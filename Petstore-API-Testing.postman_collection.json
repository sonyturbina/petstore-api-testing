  "item": [
    {
      "name": "Bug Reports",
      "item": [
        {
          "name": "BUG-001 - Invalid petId returns 404 instead of 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status code is 400\", function () {\r\n    pm.response.to.have.status(400);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pet/abc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pet",
                "abc"
              ]
            },
            "description": "Title:  \nGET /pet/{petId} returns 404 instead of 400 when petId has an invalid format\n\nPreconditions:  \nPetstore API is available.\n\nSteps to reproduce:\n\n1. Send GET request to {{base_url}}/pet/abc\n    \n2. Check the HTTP status code and response body.\n    \n\nExpected result:  \nAPI returns HTTP 400 (Invalid ID supplied), according to Swagger documentation.\n\nActual result:  \nAPI returns HTTP 404.\n\nResponse body contains a NumberFormatException for the value \"abc\".\n\nSeverity:  \nMinor"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Positive Tests",
      "item": [
        {
          "name": "Get pet by ID - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Pet ID is correct\", function () {\r\n    const jsonData = pm.response.json();\r\n   pm.expect(jsonData.id).to.eql(Number(pm.environment.get(\"petId\")));\r\n});\r\n\r\npm.test(\"Pet name is correct\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData.name).to.eql(\"SofiaDog\");\r\n});\r\n\r\npm.test(\"Pet status is available\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData.status).to.eql(\"available\");\r\n});"
                ]
              }
            }
          ],
